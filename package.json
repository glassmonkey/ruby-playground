{
  "name": "ruby-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8888",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write src e2e",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "check": "node --test scripts/pages-assets.test.mjs && npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@chakra-ui/react": "2.8.0",
    "@codesandbox/sandpack-react": "2.19.9",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.13.0",
    "@monaco-editor/react": "4.6.0",
    "@ruby/3.3-wasm-wasi": "2.10.1",
    "@ruby/3.4-wasm-wasi": "2.10.1",
    "@ruby/4.0-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "framer-motion": "11.5.4",
    "lz-string": "1.5.0",
    "monaco-editor": "0.57.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.0.1",
    "@types/node": "24.10.4",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "^25.0.1",
    "prettier": "3.9.10",
    "typescript": "5.6.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
