<div class="playground">
  <header class="playground__header">
    <h1>Ruby Playground (proof of concept)</h1>
    <p>Edit the Ruby code on the left and see the output update automatically.</p>

    <div class="playground__save">
      <% if authenticated? %>
        <%# The hidden code field is kept in sync with the editor by
            ruby-playground.js: saving copies the code into a snippet record,
            it does not turn the snippet into a second sharing URL. %>
        <%= form_with model: Snippet.new, class: "save-form" do |form| %>
          <%= form.hidden_field :code, id: "snippet-code-field" %>
          <%= form.label :title, "Save as", class: "save-form__label" %>
          <%= form.text_field :title, placeholder: "Snippet title", required: true,
                maxlength: Snippet::TITLE_MAX_LENGTH %>
          <%= form.submit "Save" %>
        <% end %>
      <% else %>
        <p class="playground__save-hint">
          <%= link_to "Sign in", new_session_path %> to save this code as a snippet.
        </p>
      <% end %>
    </div>
  </header>

  <div class="playground__panes">
    <section class="playground__pane">
      <h2>Code</h2>
      <textarea id="code">require 'rbconfig'
[
  "RUBY_VERSION: #{RUBY_VERSION}",
  "RUBY_ENGINE: #{RUBY_ENGINE}",
  "RUBY_PLATFORM: #{RUBY_PLATFORM}",
  "RUBY_DESCRIPTION: #{RUBY_DESCRIPTION}",
  "host_os: #{RbConfig::CONFIG['host_os']}",
  "ENV size: #{ENV.size}",
].join("\n")</textarea>
    </section>

    <section class="playground__pane">
      <h2>Output</h2>
      <div class="playground__output-body">
        <span id="spinner" class="spinner" hidden></span>
        <pre id="output" role="status">Loading ruby.wasm...</pre>
      </div>
    </section>
  </div>
</div>

<script type="module" src="/ruby-wasm/ruby-playground.js"></script>
