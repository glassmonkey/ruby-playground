<h1>Ruby Playground (proof of concept)</h1>

<textarea id="code" rows="10" cols="60" style="font-family: monospace;">puts "Hello, world!"
(1..5).sum</textarea>

<h2>Output</h2>
<div id="output-area" style="display: flex; align-items: center; gap: 0.5em;">
  <span id="spinner" class="spinner" hidden></span>
  <pre id="output">Loading ruby.wasm...</pre>
</div>

<style>
  .spinner {
    display: inline-block;
    width: 1em;
    height: 1em;
    border: 2px solid #ccc;
    border-top-color: #333;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  /* [hidden] must win over the display set above, or hiding it via JS
     (spinner.hidden = true) silently does nothing. */
  .spinner[hidden] {
    display: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script type="module" src="/ruby-wasm/ruby-playground.js"></script>
